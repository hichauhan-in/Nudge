<resources>
    <string name="app_name">Nudge!</string>
    <string name="accessibility_disclosure_title">Accessibility access for Nudge!</string>
    <string name="accessibility_disclosure_access">Nudge! uses the Android AccessibilityService API to detect foreground app package names and window identifiers, including while Nudge! is closed or not on screen. For apps you choose to monitor, this enables reminders over the app, session timers, schedules, and individual or shared daily limits. Strict Mode can block a selected app after its budget is used.</string>
    <string name="accessibility_disclosure_storage">Nudge! stores monitored app names and package names, usage times, session choices, timers, and limits locally on this device for reminders, history, and summaries. Nudge! does not upload this data. It is shared outside the app only if you choose to export history or a backup to a storage provider you select.</string>
    <string name="accessibility_disclosure_exclusions">Nudge! does not read screen text, messages, passwords, keystrokes, or browsing content. It does not click buttons or change settings in other apps. It is a self-management tool, not a disability-support accessibility tool or a parental-control service.</string>
    <string name="accessibility_disclosure_choice">Choose Agree and enable to consent to this accessibility access and open Android settings, where you must separately enable Nudge!. Choose Decline to continue without automatic monitoring. Back, Home, and leaving this screen do not grant consent. You can later withdraw consent in Configure, disable access in Android settings, pause monitoring, clear local data, or uninstall normally.</string>
    <string name="accessibility_agree">Agree and enable</string>
    <string name="accessibility_decline">Decline</string>
    <string name="accessibility_service_description">Shows reminders and enforces your chosen timers and daily limits for selected apps, using foreground package-change events. App names, usage times, and session choices stay on this device. Does not read screen content. Consent is required inside Nudge! before monitoring starts. Disable here at any time.</string>
